# VPS live API: live aircraft, METAR/TAF, forecast, fuel, status.
VITE_LIVE_URL=

# Turso (libSQL) Gold layer, queried straight from the browser.
# VITE_TURSO_TOKEN MUST be a READ-ONLY Turso token — it is inlined into the
# bundle and visible to anyone. Never use the write token here.
VITE_TURSO_URL=
VITE_TURSO_TOKEN=

# Optional FastAPI warehouse backend (local development only).
VITE_API_URL=http://localhost:8000
