# VPS live API: live aircraft, METAR/TAF, forecast, fuel, status.
VITE_LIVE_URL=

# MotherDuck Gold, read straight from the browser (no warehouse API, no bundle).
# Use a READ-ONLY access token. Never put the read-write pipeline token here.
VITE_MOTHERDUCK_TOKEN=
VITE_MOTHERDUCK_DATABASE=my_db

# FastAPI warehouse backend base URL (local development only — the deployed
# site does not need it).
VITE_API_URL=http://localhost:8000
