# VPS live API: live aircraft, METAR/TAF, forecast, fuel, status.
VITE_LIVE_URL=

# Turso (libSQL) Gold layer, queried straight from the browser.
# VITE_TURSO_TARGETS is a JSON array of {name,url,token,tables} — one entry per
# Turso database/account. `tables` may be omitted or "*" for a target holding
# every serving table. A table listed under more than one target is mirrored:
# the dashboard prefers the first copy and fails over to the next when an
# account is down or out of quota. All copies are independent databases (no
# Turso replication).
#
# Every token here MUST be READ-ONLY — it is inlined into the bundle and
# visible to anyone. Never put a write token in VITE_*.
#
# Example (mirror everything across two accounts):
# VITE_TURSO_TARGETS=[{"name":"eu-1","url":"libsql://...","token":"<read token>","tables":["*"]},{"name":"eu-2","url":"libsql://...","token":"<read token>","tables":["*"]}]
VITE_TURSO_TARGETS=

# Legacy single database, used only when VITE_TURSO_TARGETS is empty:
VITE_TURSO_URL=
VITE_TURSO_TOKEN=

# Optional FastAPI warehouse backend (local development only).
VITE_API_URL=http://localhost:8000
