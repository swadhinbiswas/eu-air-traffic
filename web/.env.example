# VPS live API: live aircraft, METAR/TAF, forecast, fuel, status.
VITE_LIVE_URL=

# Turso (libSQL) Gold layer, queried straight from the browser.
#
# Preferred: one variable per field, numbered from 1. A table listed under more
# than one target is mirrored, and the dashboard reads the freshest copy, falling
# over to the next when an account is down or out of quota. All copies are
# independent databases (no Turso replication). Add _2, _3, … for more targets;
# optional VITE_TURSO_NAME_n labels a target, VITE_TURSO_TABLES_n (comma list)
# restricts which tables it serves.
#
# Every token here MUST be READ-ONLY — it is inlined into the bundle and
# visible to anyone. Never put a write token in VITE_*.
VITE_TURSO_URL_1=
VITE_TURSO_TOKEN_1=
VITE_TURSO_URL_2=
VITE_TURSO_TOKEN_2=

# Alternative: a JSON array of {name,url,token,tables}. Parsed leniently, but
# still easier to mangle when pasted into a hosting dashboard.
# VITE_TURSO_TARGETS=[{"name":"eu-1","url":"libsql://...","token":"<read token>","tables":["*"]},{"name":"eu-2","url":"libsql://...","token":"<read token>","tables":["*"]}]
VITE_TURSO_TARGETS=

# Legacy single database, used only when no numbered or JSON targets are set:
VITE_TURSO_URL=
VITE_TURSO_TOKEN=

# Optional FastAPI warehouse backend (local development only).
VITE_API_URL=http://localhost:8000
