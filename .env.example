# ═══════════════════════════════════════════════════════════════════════════
#  Air Traffic Platform — Environment Configuration
#  Copy to `.env` and fill in values. NEVER commit `.env`.
# ═══════════════════════════════════════════════════════════════════════════

# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
MOCK_MODE=false                    # true => synthetic data when API keys missing

# ── External API credentials (optional in dev, required in production) ─────
AVIATIONSTACK_API_KEY=
OPENWEATHER_API_KEY=
AIRPORTDB_API_TOKEN=
OPENSKY_USERNAME=
OPENSKY_PASSWORD=
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# ── Hugging Face Hub (data lake storage) ────────────────────────────────────
HF_TOKEN=
HF_REPO=air-traffic-warehouse/air-traffic

# ── HTTP / rate limiting ────────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2.0
RATE_LIMIT_DELAY_SECONDS=0.25
OPENWEATHER_LIMIT=60

# ── Pipeline ─────────────────────────────────────────────────────────────────
PIPELINE_BATCH_SIZE=50000
DELAY_THRESHOLD_MINUTES=15

# ── Storage paths (defaults resolve under ./warehouse) ─────────────────────
# DUCKDB_PATH=warehouse/air_traffic.duckdb
