# ═══════════════════════════════════════════════════════════════════════════
#  Air Traffic Platform — Environment Configuration
#  Copy to `.env` and fill in values. NEVER commit `.env`.
#
#  Three planes:
#    VPS collector  → Kafka + live API      (AIVEN_KAFKA_*, LIVE_API_*)
#    Hugging Face   → Bronze/Silver lake    (HF_TOKEN, HF_REPO)
#    MotherDuck     → Gold warehouse (dbt)   (MOTHERDUCK_TOKEN)
#    Turso          → serving copy for the site (TURSO_*)
# ═══════════════════════════════════════════════════════════════════════════

# ── Runtime ──────────────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
MOCK_MODE=false                    # true => synthetic data when API keys missing

# ── External API credentials (optional in dev, required in production) ─────
AVIATIONSTACK_API_KEY=             # fuel prices
OPENWEATHER_API_KEY=
AIRPORTDB_API_TOKEN=
OPENSKY_USERNAME=                  # legacy; OAuth2 client below is preferred
OPENSKY_PASSWORD=
OPENSKY_CLIENT_ID=                 # OAuth2 client credentials (required now)
OPENSKY_CLIENT_SECRET=
AIRLABS_API_KEY=                   # schedules/delays; free key = 1000 calls/month

# ── Live API served by the VPS collector ─────────────────────────────────────
LIVE_API_HOST=0.0.0.0
LIVE_API_PORT=8090
# Public base URL the dashboard is built against (Cloudflare Tunnel / Caddy / DNS):
LIVE_API_PUBLIC_URL=
LIVE_API_TOKEN=                    # optional bearer for non-read endpoints
LIVE_SNAPSHOT_MAX_AGE_SECONDS=120

# ── Collector cadence (seconds) ──────────────────────────────────────────────
# Live API (dashboard) updates every tick; the lake only needs a coarser feed.
POSITIONS_INTERVAL_SECONDS=15
# How often positions are published to Kafka / the lake. 15s would be ~17M
# rows/day; 300s is the sane default while the live map stays 15s fresh.
POSITIONS_PUBLISH_INTERVAL_SECONDS=300
FLIGHTS_INTERVAL_SECONDS=300
METAR_INTERVAL_SECONDS=300
TAF_INTERVAL_SECONDS=900
FORECAST_INTERVAL_SECONDS=3600
FUEL_INTERVAL_SECONDS=86400
REFERENCE_INTERVAL_SECONDS=86400

# Concurrent upstream fetches (keep modest on a 2-core VPS).
ADSB_MAX_WORKERS=4
FLIGHTS_MAX_WORKERS=4
FLIGHTS_AIRPORTS=12
KAFKA_FLUSH_TIMEOUT_SECONDS=15

# ── Kafka event bus (Aiven) ──────────────────────────────────────────────────
AIVEN_KAFKA_HOST=
AIVEN_KAFKA_PORT=12345
AIVEN_KAFKA_USERNAME=
AIVEN_KAFKA_PASSWORD=
AIVEN_KAFKA_CA_CERT=               # path to the Aiven CA .pem (optional)
KAFKA_SECURITY_PROTOCOL=SASL_SSL   # SASL_SSL (Aiven) | PLAINTEXT (local Redpanda)
KAFKA_SASL_MECHANISM=PLAIN
# One topic per data product (defaults shown):
# KAFKA_TOPIC_POSITIONS=eu-positions
# KAFKA_TOPIC_FLIGHTS=eu-flights
# KAFKA_TOPIC_WEATHER=eu-weather
# KAFKA_TOPIC_FUEL=eu-fuel
# KAFKA_TOPIC_REFERENCE=eu-reference

# ── Kafka sink (Kafka → Bronze Parquet → Hugging Face) ───────────────────────
SINK_CONSUMER_GROUP=eu-air-traffic-sink
SINK_BATCH_SIZE=5000
SINK_POLL_TIMEOUT_MS=10000
# GitHub Actions drains a ~9-minute window each run. Kafka topic retention MUST
# exceed this (the pipeline sets it at startup; verify in Aiven).
LAKE_WINDOW_SECONDS=540
KAFKA_RETENTION_HOURS=24

# ── Hugging Face Hub (Bronze/Silver data lake) ───────────────────────────────
HF_TOKEN=
HF_REPO=swadhinbiswas/air-traffic
HF_BRONZE_PREFIX=bronze
HF_SILVER_PREFIX=silver
HF_GOLD_PREFIX=gold
HF_PRIVATE=true

# ── MotherDuck (Gold serving layer / dashboard analytics) ────────────────────
MOTHERDUCK_TOKEN=
MOTHERDUCK_DATABASE=air_traffic
# Postgres wire endpoint (BI tools / psql); optional, same token as password.
# MOTHERDUCK_PG_URL=postgresql://postgres:<token>@pg.eu-central-1-aws.motherduck.com:5432/<db>?sslmode=verify-full&sslrootcert=system
# Where the pipeline builds: local (reproducible, then publish) | motherduck
WAREHOUSE_TARGET=local
# dbt target: dev (local DuckDB) | motherduck
DBT_TARGET=dev

# ── Turso (libSQL) serving layer read by the website ─────────────────────────
# Free-tier Turso accounts have independent read/write budgets, so the serving
# copy can be spread over several databases — one target each, possibly on
# separate accounts. Each target is an independent database; no Turso
# replication is used.
#
# TURSO_TARGETS is a JSON array of {name, url, token, tables}. `tables` may be
# omitted or "*" for a target that holds every serving table. A table listed
# under more than one target is mirrored: every copy is synced, and the browser
# fails over to another copy when an account is down or out of quota. A target
# that fails does not stop publishing to the others, and tables a target is no
# longer assigned are dropped from it. `site_summary` is always written to every
# target. Leave it empty to disable the serving copy.
#
# Example (mirror everything across two accounts):
# TURSO_TARGETS='[
#   {"name": "eu-1", "url": "libsql://you-eu-1.turso.io", "token": "<write token>", "tables": ["*"]},
#   {"name": "eu-2", "url": "libsql://you-eu-2.turso.io", "token": "<write token>", "tables": ["*"]}
# ]'
TURSO_TARGETS=
# Legacy single database, used only when TURSO_TARGETS is empty:
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# The dashboard reads the same databases with READ-ONLY tokens. Prefer the
# numbered form (VITE_TURSO_URL_1/VITE_TURSO_TOKEN_1, _2, …) in the hosting
# dashboard — no JSON to mangle; VITE_TURSO_TARGETS is the JSON alternative.
# See web/.env.example and the Cloudflare Pages vars.
# Legacy single-database dashboard values:
# VITE_TURSO_URL=
# VITE_TURSO_TOKEN=

# ── AWS backends (optional) — the AWS deployment ─────────────────────────────
# The lake is Hugging Face by default; LAKE_BACKEND=s3 moves Bronze/Silver onto
# S3 (services/lake_backend.py). Credentials come from the normal boto3 chain
# (task role on ECS), never from this file.
# LAKE_BACKEND=s3
# AWS_REGION=eu-central-1
# S3_BUCKET=eu-air-traffic-lake
# S3_PREFIX=
# S3_ENDPOINT_URL=                 # only for LocalStack/MinIO in tests
# S3_STORAGE_CLASS=STANDARD

# Serving copy on AWS: scripts/run_lake.sh reads SERVING_BACKEND
# (turso [default] | aurora | none). DATABASE_URL is the Aurora writer the
# publisher uses; the dashboard gets the read-only reader endpoint separately.
# AURORA_IAM_AUTH=true uses a short-lived RDS token instead of a password.
# SERVING_BACKEND=aurora
# DATABASE_URL=postgresql://publisher@writer.example.rds.amazonaws.com:5432/serving?sslmode=require
# SERVING_DATABASE_URL=postgresql://dashboard_ro@reader.example.rds.amazonaws.com:5432/serving?sslmode=require
# AURORA_IAM_AUTH=true
# PG_SCHEMA=public

# ── HTTP / rate limiting ────────────────────────────────────────────────────
REQUEST_TIMEOUT_SECONDS=15
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2.0
RATE_LIMIT_DELAY_SECONDS=0.25
OPENWEATHER_LIMIT=60

# ── Pipeline ─────────────────────────────────────────────────────────────────
PIPELINE_BATCH_SIZE=50000
DELAY_THRESHOLD_MINUTES=15

# ── Dashboard build (Vite, build-time) ───────────────────────────────────────
VITE_LIVE_URL=                     # e.g. https://live.example.com (the VPS live API)
VITE_API_URL=http://localhost:8000

# ── Storage paths (defaults resolve under ./warehouse) ─────────────────────
# DUCKDB_PATH=warehouse/air_traffic.duckdb
# AIR_TRAFFIC_DUCKDB_PATH=warehouse/air_traffic.duckdb  # dbt only
